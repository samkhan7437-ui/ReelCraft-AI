Dialogue: 0,0:00:00.10,0:00:01.74,YellowPop,,0,0,0,,१९७४ में गहरे
Dialogue: 0,0:00:01.74,0:00:03.37,WhitePop,,0,0,0,,समुद्र के गोताखोर
Dialogue: 0,0:00:03.37,0:00:05.01,GreenPop,,0,0,0,,रॉबर्ट शॉ प्रशांत
Dialogue: 0,0:00:05.01,0:00:06.65,WhitePop,,0,0,0,,महासागर में आठ
Dialogue: 0,0:00:06.65,0:00:08.28,YellowPop,,0,0,0,,हजार फीट नीचे
Dialogue: 0,0:00:08.28,0:00:09.92,WhitePop,,0,0,0,,एक कैप्सूल में
Dialogue: 0,0:00:09.92,0:00:11.01,GreenPop,,0,0,0,,बंद थे।
Dialogue: 0,0:00:10.96,0:00:12.45,WhitePop,,0,0,0,,रात के दो
Dialogue: 0,0:00:12.45,0:00:13.94,YellowPop,,0,0,0,,बजकर चौदह मिनट
Dialogue: 0,0:00:13.94,0:00:15.42,WhitePop,,0,0,0,,पर उनका संपर्क
Dialogue: 0,0:00:15.42,0:00:16.42,GreenPop,,0,0,0,,टूट गया।
Dialogue: 0,0:00:16.42,0:00:18.82,WhitePop,,0,0,0,,सन्नाटा छा गया।
Dialogue: 0,0:00:18.82,0:00:20.41,YellowPop,,0,0,0,,तभी टाइटेनियम की
Dialogue: 0,0:00:20.41,0:00:22.00,WhitePop,,0,0,0,,दीवार के बाहर
Dialogue: 0,0:00:22.00,0:00:23.59,GreenPop,,0,0,0,,से उन्हें तीन
Dialogue: 0,0:00:23.59,0:00:25.19,WhitePop,,0,0,0,,लगातार खटखटाने की
Dialogue: 0,0:00:25.19,0:00:26.78,YellowPop,,0,0,0,,आवाजें सुनाई दीं।
Dialogue: 0,0:00:26.78,0:00:28.24,WhitePop,,0,0,0,,जैसे कोई लोहे
Dialogue: 0,0:00:28.24,0:00:29.70,GreenPop,,0,0,0,,पर उंगलियों से
Dialogue: 0,0:00:29.70,0:00:31.17,WhitePop,,0,0,0,,दस्तक दे रहा
Dialogue: 0,0:00:31.17,0:00:31.65,YellowPop,,0,0,0,,हो।
Dialogue: 0,0:00:31.65,0:00:33.18,WhitePop,,0,0,0,,सोनार पर पचास
Dialogue: 0,0:00:33.18,0:00:34.70,GreenPop,,0,0,0,,मील तक कोई
Dialogue: 0,0:00:34.70,0:00:36.22,WhitePop,,0,0,0,,जीव नहीं था।
Dialogue: 0,0:00:36.22,0:00:37.61,YellowPop,,0,0,0,,जब कैप्सूल ऊपर
Dialogue: 0,0:00:37.61,0:00:38.99,WhitePop,,0,0,0,,लाया गया, तो
Dialogue: 0,0:00:38.99,0:00:40.38,GreenPop,,0,0,0,,स्टील के गेट
Dialogue: 0,0:00:40.38,0:00:41.76,WhitePop,,0,0,0,,पर इंसान की
Dialogue: 0,0:00:41.76,0:00:43.14,YellowPop,,0,0,0,,उंगलियों के तीन
Dialogue: 0,0:00:43.14,0:00:44.53,WhitePop,,0,0,0,,गहरे निशान मिले।
Dialogue: 0,0:00:44.53,0:00:45.95,GreenPop,,0,0,0,,रॉबर्ट ने अगली
Dialogue: 0,0:00:45.95,0:00:47.37,WhitePop,,0,0,0,,सुबह नौकरी छोड़
Dialogue: 0,0:00:47.37,0:00:48.79,YellowPop,,0,0,0,,दी और फिर
Dialogue: 0,0:00:48.79,0:00:50.21,WhitePop,,0,0,0,,कभी समुद्र की
Dialogue: 0,0:00:50.21,0:00:51.63,GreenPop,,0,0,0,,तरफ नहीं देखा।
Dialogue: 0,0:00:51.63,0:00:53.10,WhitePop,,0,0,0,,आपको क्या लगता
Dialogue: 0,0:00:53.10,0:00:54.58,YellowPop,,0,0,0,,है वह क्या
Dialogue: 0,0:00:54.58,0:00:55.07,WhitePop,,0,0,0,,था?
Dialogue: 0,0:00:55.07,0:00:56.79,GreenPop,,0,0,0,,फॉलो करें ऐसी
Dialogue: 0,0:00:56.79,0:00:58.52,WhitePop,,0,0,0,,ही अनसुलझी कहानियों
Dialogue: 0,0:00:58.52,0:00:59.67,YellowPop,,0,0,0,,के लिए।