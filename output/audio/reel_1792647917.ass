Dialogue: 0,0:00:00.10,0:00:01.42,YellowPop,,0,0,0,,क्या आप जानते
Dialogue: 0,0:00:01.42,0:00:02.73,WhitePop,,0,0,0,,हैं कि हमारी
Dialogue: 0,0:00:02.73,0:00:04.05,GreenPop,,0,0,0,,पृथ्वी पर एक
Dialogue: 0,0:00:04.05,0:00:05.37,WhitePop,,0,0,0,,ऐसा जीव मौजूद
Dialogue: 0,0:00:05.37,0:00:06.68,YellowPop,,0,0,0,,है जो कभी
Dialogue: 0,0:00:06.68,0:00:08.00,WhitePop,,0,0,0,,बूढ़ा होकर नहीं
Dialogue: 0,0:00:08.00,0:00:08.44,GreenPop,,0,0,0,,मरता?
Dialogue: 0,0:00:08.39,0:00:09.73,WhitePop,,0,0,0,,टुरिटोप्सिस डोहर्नी नाम
Dialogue: 0,0:00:09.73,0:00:11.08,YellowPop,,0,0,0,,की यह जेलीफ़िश
Dialogue: 0,0:00:11.08,0:00:12.42,WhitePop,,0,0,0,,जब भी बीमार
Dialogue: 0,0:00:12.42,0:00:13.77,GreenPop,,0,0,0,,या बूढ़ी होती
Dialogue: 0,0:00:13.77,0:00:15.11,WhitePop,,0,0,0,,है, तो यह
Dialogue: 0,0:00:15.11,0:00:16.46,YellowPop,,0,0,0,,अपनी कोशिकाओं को
Dialogue: 0,0:00:16.46,0:00:17.80,WhitePop,,0,0,0,,रिवर्स करके वापस
Dialogue: 0,0:00:17.80,0:00:19.14,GreenPop,,0,0,0,,एक नन्हे बच्चे
Dialogue: 0,0:00:19.14,0:00:20.49,WhitePop,,0,0,0,,के रूप में
Dialogue: 0,0:00:20.49,0:00:21.83,YellowPop,,0,0,0,,बदल लेती है।
Dialogue: 0,0:00:21.83,0:00:23.19,WhitePop,,0,0,0,,यह बिल्कुल वैसा
Dialogue: 0,0:00:23.19,0:00:24.55,GreenPop,,0,0,0,,है जैसे कोई
Dialogue: 0,0:00:24.55,0:00:25.90,WhitePop,,0,0,0,,८० साल का
Dialogue: 0,0:00:25.90,0:00:27.26,YellowPop,,0,0,0,,इंसान बूढ़ा होने
Dialogue: 0,0:00:27.26,0:00:28.61,WhitePop,,0,0,0,,पर दोबारा ६
Dialogue: 0,0:00:28.61,0:00:29.97,GreenPop,,0,0,0,,साल का बच्चा
Dialogue: 0,0:00:29.97,0:00:30.88,WhitePop,,0,0,0,,बन जाए।
Dialogue: 0,0:00:30.88,0:00:32.28,YellowPop,,0,0,0,,वैज्ञानिक दशकों से
Dialogue: 0,0:00:32.28,0:00:33.69,WhitePop,,0,0,0,,इसके डीएनए पर
Dialogue: 0,0:00:33.69,0:00:35.09,GreenPop,,0,0,0,,रिसर्च कर रहे
Dialogue: 0,0:00:35.09,0:00:36.50,WhitePop,,0,0,0,,हैं ताकि इंसानों
Dialogue: 0,0:00:36.50,0:00:37.90,YellowPop,,0,0,0,,में बढ़ती उम्र
Dialogue: 0,0:00:37.90,0:00:39.31,WhitePop,,0,0,0,,को रोका जा
Dialogue: 0,0:00:39.31,0:00:39.78,GreenPop,,0,0,0,,सके।
Dialogue: 0,0:00:39.78,0:00:41.27,WhitePop,,0,0,0,,जब तक कोई
Dialogue: 0,0:00:41.27,0:00:42.76,YellowPop,,0,0,0,,दूसरा जीव इसे
Dialogue: 0,0:00:42.76,0:00:44.26,WhitePop,,0,0,0,,खा न जाए,
Dialogue: 0,0:00:44.26,0:00:45.75,GreenPop,,0,0,0,,यह अमर है।
Dialogue: 0,0:00:45.75,0:00:47.19,WhitePop,,0,0,0,,क्या यह छोटा
Dialogue: 0,0:00:47.19,0:00:48.64,YellowPop,,0,0,0,,सा जीव इंसानों
Dialogue: 0,0:00:48.64,0:00:50.08,WhitePop,,0,0,0,,को हमेशा जवान
Dialogue: 0,0:00:50.08,0:00:51.52,GreenPop,,0,0,0,,रखने का राज़
Dialogue: 0,0:00:51.52,0:00:52.49,WhitePop,,0,0,0,,जानता है?
Dialogue: 0,0:00:52.49,0:00:54.78,YellowPop,,0,0,0,,कमेंट में बताएं।