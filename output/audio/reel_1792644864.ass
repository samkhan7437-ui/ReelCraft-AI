Dialogue: 0,0:00:00.10,0:00:01.56,YellowPop,,0,0,0,,१९७४ में गहरे
Dialogue: 0,0:00:01.56,0:00:03.02,WhitePop,,0,0,0,,समुद्र के गोताखोर
Dialogue: 0,0:00:03.02,0:00:04.48,GreenPop,,0,0,0,,रॉबर्ट शॉ प्रशांत
Dialogue: 0,0:00:04.48,0:00:05.94,WhitePop,,0,0,0,,महासागर में आठ
Dialogue: 0,0:00:05.94,0:00:07.40,YellowPop,,0,0,0,,हजार फीट नीचे
Dialogue: 0,0:00:07.40,0:00:08.86,WhitePop,,0,0,0,,एक कैप्सूल में
Dialogue: 0,0:00:08.86,0:00:09.84,GreenPop,,0,0,0,,बंद थे।
Dialogue: 0,0:00:09.79,0:00:11.16,WhitePop,,0,0,0,,रात के दो
Dialogue: 0,0:00:11.16,0:00:12.54,YellowPop,,0,0,0,,बजकर चौदह मिनट
Dialogue: 0,0:00:12.54,0:00:13.91,WhitePop,,0,0,0,,पर उनका संपर्क
Dialogue: 0,0:00:13.91,0:00:14.82,GreenPop,,0,0,0,,टूट गया।
Dialogue: 0,0:00:14.82,0:00:17.16,WhitePop,,0,0,0,,सन्नाटा छा गया।
Dialogue: 0,0:00:17.16,0:00:18.67,YellowPop,,0,0,0,,तभी टाइटेनियम की
Dialogue: 0,0:00:18.67,0:00:20.18,WhitePop,,0,0,0,,दीवार के बाहर
Dialogue: 0,0:00:20.18,0:00:21.69,GreenPop,,0,0,0,,से उन्हें तीन
Dialogue: 0,0:00:21.69,0:00:23.19,WhitePop,,0,0,0,,लगातार खटखटाने की
Dialogue: 0,0:00:23.19,0:00:24.70,YellowPop,,0,0,0,,आवाजें सुनाई दीं।
Dialogue: 0,0:00:24.70,0:00:26.01,WhitePop,,0,0,0,,जैसे कोई लोहे
Dialogue: 0,0:00:26.01,0:00:27.32,GreenPop,,0,0,0,,पर उंगलियों से
Dialogue: 0,0:00:27.32,0:00:28.63,WhitePop,,0,0,0,,दस्तक दे रहा
Dialogue: 0,0:00:28.63,0:00:29.06,YellowPop,,0,0,0,,हो।
Dialogue: 0,0:00:29.06,0:00:30.46,WhitePop,,0,0,0,,सोनार पर पचास
Dialogue: 0,0:00:30.46,0:00:31.85,GreenPop,,0,0,0,,मील तक कोई
Dialogue: 0,0:00:31.85,0:00:33.25,WhitePop,,0,0,0,,जीव नहीं था।
Dialogue: 0,0:00:33.25,0:00:34.48,YellowPop,,0,0,0,,जब कैप्सूल ऊपर
Dialogue: 0,0:00:34.48,0:00:35.71,WhitePop,,0,0,0,,लाया गया, तो
Dialogue: 0,0:00:35.71,0:00:36.94,GreenPop,,0,0,0,,स्टील के गेट
Dialogue: 0,0:00:36.94,0:00:38.17,WhitePop,,0,0,0,,पर इंसान की
Dialogue: 0,0:00:38.17,0:00:39.40,YellowPop,,0,0,0,,उंगलियों के तीन
Dialogue: 0,0:00:39.40,0:00:40.62,WhitePop,,0,0,0,,गहरे निशान मिले।
Dialogue: 0,0:00:40.62,0:00:41.92,GreenPop,,0,0,0,,रॉबर्ट ने अगली
Dialogue: 0,0:00:41.92,0:00:43.22,WhitePop,,0,0,0,,सुबह नौकरी छोड़
Dialogue: 0,0:00:43.22,0:00:44.52,YellowPop,,0,0,0,,दी और फिर
Dialogue: 0,0:00:44.52,0:00:45.82,WhitePop,,0,0,0,,कभी समुद्र की
Dialogue: 0,0:00:45.82,0:00:47.12,GreenPop,,0,0,0,,तरफ नहीं देखा।
Dialogue: 0,0:00:47.12,0:00:48.43,WhitePop,,0,0,0,,आपको क्या लगता
Dialogue: 0,0:00:48.43,0:00:49.73,YellowPop,,0,0,0,,है वह क्या
Dialogue: 0,0:00:49.73,0:00:50.16,WhitePop,,0,0,0,,था?
Dialogue: 0,0:00:50.16,0:00:51.68,GreenPop,,0,0,0,,फॉलो करें ऐसी
Dialogue: 0,0:00:51.68,0:00:53.20,WhitePop,,0,0,0,,ही अनसुलझी कहानियों
Dialogue: 0,0:00:53.20,0:00:54.21,YellowPop,,0,0,0,,के लिए।