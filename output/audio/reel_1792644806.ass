Dialogue: 0,0:00:00.10,0:00:01.72,YellowPop,,0,0,0,,१९७४ में गहरे
Dialogue: 0,0:00:01.72,0:00:03.35,WhitePop,,0,0,0,,समुद्र के गोताखोर
Dialogue: 0,0:00:03.35,0:00:04.97,GreenPop,,0,0,0,,रॉबर्ट शॉ प्रशांत
Dialogue: 0,0:00:04.97,0:00:06.59,WhitePop,,0,0,0,,महासागर में आठ
Dialogue: 0,0:00:06.59,0:00:08.21,YellowPop,,0,0,0,,हजार फीट नीचे
Dialogue: 0,0:00:08.21,0:00:09.84,WhitePop,,0,0,0,,एक कैप्सूल में
Dialogue: 0,0:00:09.84,0:00:10.92,GreenPop,,0,0,0,,बंद थे।
Dialogue: 0,0:00:10.87,0:00:12.40,WhitePop,,0,0,0,,रात के दो
Dialogue: 0,0:00:12.40,0:00:13.92,YellowPop,,0,0,0,,बजकर चौदह मिनट
Dialogue: 0,0:00:13.92,0:00:15.45,WhitePop,,0,0,0,,पर उनका संपर्क
Dialogue: 0,0:00:15.45,0:00:16.47,GreenPop,,0,0,0,,टूट गया।
Dialogue: 0,0:00:16.47,0:00:19.06,WhitePop,,0,0,0,,सन्नाटा छा गया।
Dialogue: 0,0:00:19.06,0:00:20.74,YellowPop,,0,0,0,,तभी टाइटेनियम की
Dialogue: 0,0:00:20.74,0:00:22.41,WhitePop,,0,0,0,,दीवार के बाहर
Dialogue: 0,0:00:22.41,0:00:24.09,GreenPop,,0,0,0,,से उन्हें तीन
Dialogue: 0,0:00:24.09,0:00:25.76,WhitePop,,0,0,0,,लगातार खटखटाने की
Dialogue: 0,0:00:25.76,0:00:27.44,YellowPop,,0,0,0,,आवाजें सुनाई दीं।
Dialogue: 0,0:00:27.44,0:00:28.89,WhitePop,,0,0,0,,जैसे कोई लोहे
Dialogue: 0,0:00:28.89,0:00:30.35,GreenPop,,0,0,0,,पर उंगलियों से
Dialogue: 0,0:00:30.35,0:00:31.80,WhitePop,,0,0,0,,दस्तक दे रहा
Dialogue: 0,0:00:31.80,0:00:32.29,YellowPop,,0,0,0,,हो।
Dialogue: 0,0:00:32.29,0:00:33.84,WhitePop,,0,0,0,,सोनार पर पचास
Dialogue: 0,0:00:33.84,0:00:35.39,GreenPop,,0,0,0,,मील तक कोई
Dialogue: 0,0:00:35.39,0:00:36.94,WhitePop,,0,0,0,,जीव नहीं था।
Dialogue: 0,0:00:36.94,0:00:38.30,YellowPop,,0,0,0,,जब कैप्सूल ऊपर
Dialogue: 0,0:00:38.30,0:00:39.67,WhitePop,,0,0,0,,लाया गया, तो
Dialogue: 0,0:00:39.67,0:00:41.04,GreenPop,,0,0,0,,स्टील के गेट
Dialogue: 0,0:00:41.04,0:00:42.40,WhitePop,,0,0,0,,पर इंसान की
Dialogue: 0,0:00:42.40,0:00:43.77,YellowPop,,0,0,0,,उंगलियों के तीन
Dialogue: 0,0:00:43.77,0:00:45.13,WhitePop,,0,0,0,,गहरे निशान मिले।
Dialogue: 0,0:00:45.13,0:00:46.58,GreenPop,,0,0,0,,रॉबर्ट ने अगली
Dialogue: 0,0:00:46.58,0:00:48.02,WhitePop,,0,0,0,,सुबह नौकरी छोड़
Dialogue: 0,0:00:48.02,0:00:49.47,YellowPop,,0,0,0,,दी और फिर
Dialogue: 0,0:00:49.47,0:00:50.91,WhitePop,,0,0,0,,कभी समुद्र की
Dialogue: 0,0:00:50.91,0:00:52.36,GreenPop,,0,0,0,,तरफ नहीं देखा।
Dialogue: 0,0:00:52.36,0:00:53.80,WhitePop,,0,0,0,,आपको क्या लगता
Dialogue: 0,0:00:53.80,0:00:55.25,YellowPop,,0,0,0,,है वह क्या
Dialogue: 0,0:00:55.25,0:00:55.73,WhitePop,,0,0,0,,था?
Dialogue: 0,0:00:55.73,0:00:57.42,GreenPop,,0,0,0,,फॉलो करें ऐसी
Dialogue: 0,0:00:57.42,0:00:59.11,WhitePop,,0,0,0,,ही अनसुलझी कहानियों
Dialogue: 0,0:00:59.11,0:01:00.23,YellowPop,,0,0,0,,के लिए।