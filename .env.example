# ReelCraft AI Configuration

# LLM Provider for Script Generation: "builtin", "ollama", "gemini", or "openai"
LLM_PROVIDER=builtin

# Ollama Settings (if using local Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud LLM API Keys (optional - leave empty if using builtin or ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Meta / Instagram Graph API Configuration
# Required only when publishing live to Instagram
# Requires: Instagram Creator/Business account connected to a Facebook Page
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Pexels API Key (optional - for auto-downloading matching vertical B-roll clips)
PEXELS_API_KEY=

# App Server Settings
PORT=8000
HOST=127.0.0.1
